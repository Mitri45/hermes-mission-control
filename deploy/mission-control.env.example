# Mission Control API deployment environment (DIM-213)
# Copy to ~/.config/hermes/mission-control.env and keep file mode 600.

# Runtime mode + API auth
ENVIRONMENT=production
AUTH_MODE=all
BEARER_TOKEN=replace-with-strong-random-token
EXPOSE_DOCS=false
CORS_ORIGINS=["https://hermes.your-domain.example"]
DASHBOARD_AUTH_MODE=cloudflare
DASHBOARD_SHARED_SECRET=replace-with-dashboard-origin-secret

# Hermes paths
HERMES_HOME=/home/your-user/.hermes

# DIM-237 migration baseline (Pi -> PC ingest now targets Hindsight)
MEMORY_INGEST_BACKEND=hindsight
MEMORY_INGEST_HMAC_SECRET=replace-with-shared-hmac-secret
MEMORY_INGEST_ALLOWED_SOURCES=["100.67.97.50"]
MEMORY_INGEST_HINDSIGHT_BASE_URL=http://127.0.0.1:9177
MEMORY_INGEST_HINDSIGHT_BANK=hermes

# Optional key rotation support
# MEMORY_INGEST_HMAC_NEXT_SECRET=replace-with-next-secret
